# Template. Copy to .env and fill in the real values.
#
#   cp .env.example .env
#
# .env is gitignored; this file is committed. Never put a real
# value in this file.

# Supabase — max-dev (development project)
# Both of these are safe to expose: EXPO_PUBLIC_ variables are
# inlined into the app bundle, and the publishable key is designed
# for exactly that. Row Level Security is what protects the data,
# not the secrecy of this key.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Do not add the sb_secret_ key or the database password here, or
# in .env. They bypass Row Level Security completely, this is a
# client project with no server-side code to use them, and anything
# that picks up an EXPO_PUBLIC_ prefix ships to every installed app.
# They belong in server-side config from M2e onwards.
