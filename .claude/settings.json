{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm exec *)",
      "Bash(echo \"eslint exit: $?\")",
      "Bash(git log *)",
      "Bash(ls -la \"C:/Users/tarun/.claude/projects/c--Users-tarun-projects-max-app/memory/\" 2>/dev/null && echo \"--- MEMORY.md ---\" && cat \"C:/Users/tarun/.claude/projects/c--Users-tarun-projects-max-app/memory/MEMORY.md\" 2>/dev/null || echo \"\\(no MEMORY.md yet\\)\")",
      "Read(//c/Users/tarun/.claude/projects/c--Users-tarun-projects-max-app/**)",
      "Bash(gh api *)",
      "Bash(git show-ref *)",
      "Bash(command -v curl)",
      "Bash(curl -s -H \"Accept: application/vnd.github+json\" https://api.github.com/repos/tarunkauxhik/max-app/contributors)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./secrets/**)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./secrets/**)",
      "PowerShell(git push --force *)",
      "PowerShell(git reset --hard *)",
      "Bash(git push --force *)",
      "Bash(git reset --hard *)",
      "PowerShell(Get-Content .env*)",
      "PowerShell(type .env*)",
      "Bash(cat .env*)",
      "Bash(head .env*)",
      "Bash(tail .env*)"
    ],
    "ask": [
      "PowerShell(pnpm add *)",
      "PowerShell(pnpm remove *)",
      "PowerShell(pnpm update *)",
      "PowerShell(pnpm exec expo prebuild *)",
      "PowerShell(pnpm exec expo run:*)",
      "PowerShell(eas build *)",
      "PowerShell(Remove-Item *)",
      "PowerShell(git push *)",
      "Bash(pnpm add *)",
      "Bash(pnpm remove *)",
      "Bash(pnpm update *)",
      "Bash(pnpm exec expo prebuild *)",
      "Bash(pnpm exec expo run:*)",
      "Bash(eas build *)",
      "Bash(rm -r *)",
      "Bash(rm -rf *)",
      "Bash(git push *)"
    ],
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable",
    "disableAutoMode": "disable"
  },
  "enabledPlugins": {
    "expo@claude-plugins-official": true
  }
}
